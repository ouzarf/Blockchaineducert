# PostgreSQL obligatoire pour le backend institutionnel.
# Configurez cette valeur localement dans Windows; ne la mettez jamais dans Git.
DATABASE_URL=postgresql+psycopg://educert_user:CHANGE_ME@localhost:5432/educert

# En production, remplacer * par les domaines HTTPS autorisés.
EDUCERT_CORS_ORIGINS=*

# Authentification institutionnelle future (OIDC/JWT)
# AUTH_REQUIRED=false
# AUTH_ISSUER=https://idp.example.org/realms/educert
# AUTH_AUDIENCE=educert-api
